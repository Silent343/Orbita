<Window x:Class="Orbita.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root">
    <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Padding="20,0,160,0" Background="Transparent">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <FontIcon Glyph="&#xE9CA;" FontSize="16" Foreground="{ThemeResource OrbitAccentBrush}" />
        <TextBlock Text="{Binding L.Strings[AppName].Value}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding L.Strings[AppTagline].Value}" Opacity="0.55" Margin="12,0,0,0" />
      </StackPanel>
    </Grid>
    <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False" PaneDisplayMode="Left" OpenPaneLength="220"
        IsPaneToggleButtonVisible="False" SelectionChanged="Navigation_SelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="WorkspaceItem" Tag="workspace" Content="{Binding L.Strings[NavWorkspace].Value}">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Tag="history" Content="{Binding L.Strings[NavHistory].Value}">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem Tag="settings" Content="{Binding L.Strings[NavSettings].Value}">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <Grid Padding="24,12,24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <InfoBar x:Name="NoticeBar" IsOpen="False" Margin="0,0,0,12" />
        <ContentControl x:Name="PageHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      </Grid>
    </NavigationView>
  </Grid>
</Window>
